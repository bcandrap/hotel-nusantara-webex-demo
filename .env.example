# =============================================================================
# Webex Calling Click-to-Call Configuration
# =============================================================================
# Copy this file to .env for local dev (don't commit .env!)
# For production, set these in Netlify dashboard:
#   Site settings → Environment variables → Add variable

# Service App access token from Webex Developer Portal
# Get it from: https://developer.webex.com/my-apps → Create New App → Service App
# Note: Service App tokens expire every 14 days unless you implement refresh
WEBEX_SERVICE_APP_TOKEN=your_service_app_token_here

# Destination phone number for Click-to-Call
# Can be Auto Attendant extension (e.g., "4500") or E.164 (e.g., "+622112345678")
# Must be a number reachable in your Webex Calling org
WEBEX_CALLED_NUMBER=4500

# Optional: default display name for the guest caller
# Frontend can override per call. If not set, defaults to "Guest"
WEBEX_GUEST_NAME_DEFAULT=Hotel Nusantara Guest
